# Batch 10 — the Xcode toolchain installed in this environment (27.0) only
# supports iOS deployment targets 15.0 and up; several third-party pods'
# own podspecs still declare a lower minimum (e.g. 9.0/12.0), which Xcode
# now rejects even though the Runner target itself was already raised to
# 15.0 (`project.pbxproj`). Setting this here is the standard CocoaPods
# mechanism to raise every pod target's deployment target to at least this
# floor, regardless of what each pod's own podspec declares.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Batch 10 — `platform :ios, '15.0'` above only raises a pod's
    # deployment target when its own podspec doesn't declare one; at least
    # one plugin (flutter_tts) declares an explicit, older minimum (8.0),
    # which CocoaPods otherwise keeps as-is and Xcode 27 then rejects
    # outright ("Target Integrity"). Force every individual pod target's
    # build setting up to the same floor as the Runner project itself,
    # the standard fix for this exact class of problem — never lowers a
    # target that's already >= 15.0.
    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if deployment_target && deployment_target.to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
